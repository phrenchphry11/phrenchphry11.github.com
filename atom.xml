---
layout: nil
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
 
 <title>Post Facto</title>
 <link href="https://hollyafrench.com/atom.xml" rel="self"/>
 <link href="https://hollyafrench.com/"/>
 <updated>{{ site.time | date_to_xmlschema }}</updated>
 <id>https://hollyafrench.com/</id>
 <author>
   <name>Holly French</name>
   <email>hollyafrench90@gmail.com</email>
 </author>
 
 {% for post in site.posts %}
 <entry>
   <title>{{ post.title }}</title>
   <link href="https://hollyafrench.com{{ post.url }}"/>
   <updated>{{ post.date | date_to_xmlschema }}</updated>
   <id>https://hollyafrench.com{{ post.id }}</id>
   <content type="html">{{ post.content | xml_escape }}</content>
 </entry>
 {% endfor %}
 
</feed>
